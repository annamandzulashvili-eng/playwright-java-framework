<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  UI suite: runs every test in group "ui".
  Run: mvn verify -Dsuite=ui   (thread count can be overridden with -Dthreads=N)
-->
<suite name="UI" parallel="methods" thread-count="4" data-provider-thread-count="2">
    <!-- FrameworkSuiteListener is registered via META-INF/services, so it also runs with -Dtest=... -->
    <test name="UI">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <packages>
            <package name="qa.tests.*"/>
        </packages>
    </test>
</suite>
