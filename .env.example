# Copy to .env (git-ignored) and fill in. Never commit real values.
#
# Used by:
#  - Claude Code's Qase MCP server (.mcp.json reads QASE_API_TOKEN from your environment)
#  - optional local reporting to Qase (QASE_MODE=testops)
#
# Load into the current shell before starting Claude Code or Maven:
#   PowerShell: Get-Content .env | Where-Object { $_ -match '^[A-Z]' } | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   bash/zsh:   set -a; source .env; set +a

QASE_API_TOKEN=
QASE_PROJECT=PJF

# Uncomment to send results of a local run to Qase (creates a new run in project PJF).
# Paste the same token again: the loaders above do not expand variables.
# QASE_MODE=testops
# QASE_TESTOPS_API_TOKEN=
# QASE_TESTOPS_PROJECT=PJF
