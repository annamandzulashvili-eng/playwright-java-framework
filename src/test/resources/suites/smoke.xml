<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Smoke suite: runs every test in group "smoke".
  Run: mvn verify -Dsuite=smoke   (thread count can be overridden with -Dthreads=N)
-->
<suite name="Smoke" parallel="methods" thread-count="4" data-provider-thread-count="2">
    <!-- FrameworkSuiteListener is registered via META-INF/services, so it also runs with -Dtest=... -->
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="qa.tests.*"/>
        </packages>
    </test>
</suite>
