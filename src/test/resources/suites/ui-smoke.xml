<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  UI smoke suite: smoke tests except API ones (used by CI on pull requests).
  Run: mvn verify -Dsuite=ui-smoke   (thread count can be overridden with -Dthreads=N)
-->
<suite name="UI Smoke" parallel="methods" thread-count="4" data-provider-thread-count="2">
    <!-- FrameworkSuiteListener is registered via META-INF/services, so it also runs with -Dtest=... -->
    <test name="UI Smoke">
        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="api"/>
            </run>
        </groups>
        <packages>
            <package name="qa.tests.*"/>
        </packages>
    </test>
</suite>
